# 告警通道配置示例（复制到 /opt/news-broadcast/alert.env，权限 600）
# 飞书开放平台直发
NEWS_FEISHU_APP_ID=cli_xxxxxxxxxxxx
NEWS_FEISHU_APP_SECRET=xxxxxxxxxxxx
NEWS_FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# 企业微信群机器人 webhook（留空则跳过）
NEWS_WECOM_WEBHOOK=

# hermes 投递目标（逗号分隔），QQ/企微走队列
NEWS_HERMES_TARGETS=feishu:oc_xxxxxxxxxxxx,lightclawbot:616601857,weixin:o9cqxxxxxxxx@im.wechat

# 是否允许调用 hermes send
NEWS_HERMES_SEND=1
